generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  myUser        MyUsers?

  @@map("user")
}

model MyUsers {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [id], references: [id], onDelete: Cascade)
  applications  Application[]
  improvedFiles ImprovedFile[]
  savedSuggestions SavedSuggestion[]

  @@map("myusers")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Application {
  id               String   @id @default(uuid())
  myUserId         String
  title            String
  company          String
  originalFilename String
  fileType         String
  fileUrl          String
  storageKey       String
  fileSizeBytes    BigInt
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  myUser           MyUsers  @relation(fields: [myUserId], references: [id], onDelete: Cascade)
  analysis         AIAnalysis?
  savedSuggestions SavedSuggestion[]

  @@index([myUserId])
  @@map("applications")
}

model AIAnalysis {
  id               String   @id @default(uuid())
  applicationId    String   @unique
  rawTextExtracted String
  aiSuggestionText String
  modelUsed        String
  tokensUsed       Int
  analysisStatus   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  improvedFiles    ImprovedFile[]
  savedSuggestions SavedSuggestion[]

  @@map("ai_analyses")
}

model ImprovedFile {
  id               String   @id @default(uuid())
  analysisId       String
  myUserId         String
  fileUrl          String
  storageKey       String
  fileType         String
  fileSizeBytes    BigInt
  generationStatus String
  isDownloaded     Boolean  @default(false)
  downloadedAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  analysis         AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  myUser           MyUsers    @relation(fields: [myUserId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([myUserId])
  @@map("improved_files")
}

model SavedSuggestion {
  id             String   @id @default(uuid())
  myUserId       String
  analysisId     String
  applicationId  String
  title          String
  suggestionText String
  isApplied      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  myUser         MyUsers  @relation(fields: [myUserId], references: [id], onDelete: Cascade)
  analysis        AIAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([myUserId])
  @@index([analysisId])
  @@index([applicationId])
  @@map("saved_suggestions")
}

model people {
  id        Int      @id(map: "id") @default(autoincrement())
  birthdate DateTime @db.Date
  firstname String   @db.VarChar(50)
  lastname  String   @db.VarChar(60)
}
