generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  myUser        myusers?
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model applications {
  id               String              @id @default(uuid())
  myUserId         String
  title            String
  company          String
  originalFilename String
  fileType         String
  fileUrl          String
  storageKey       String
  fileSizeBytes    BigInt
  status           String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  analysis         ai_analyses?
  myUser           myusers             @relation(fields: [myUserId], references: [id], onDelete: Cascade)
  savedSuggestions saved_suggestions[]

  @@index([myUserId])
  @@map("applications")
}

model ai_analyses {
  id               String              @id @default(uuid())
  applicationId    String              @unique
  rawTextExtracted String
  aiSuggestionText String
  modelUsed        String
  tokensUsed       Int
  analysisStatus   String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  application      applications        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  improvedFiles    improved_files[]
  savedSuggestions saved_suggestions[]

  @@map("ai_analyses")
}

model improved_files {
  id               String      @id @default(uuid())
  analysisId       String
  myUserId         String
  fileUrl          String
  storageKey       String
  fileType         String
  fileSizeBytes    BigInt
  generationStatus String
  isDownloaded     Boolean     @default(false)
  downloadedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  analysis         ai_analyses @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  myUser           myusers     @relation(fields: [myUserId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([myUserId])
  @@map("improved_files")
}

model saved_suggestions {
  id             String       @id @default(uuid())
  myUserId       String
  analysisId     String
  applicationId  String
  title          String
  suggestionText String
  isApplied      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  analysis       ai_analyses  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  application    applications @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  myUser         myusers      @relation(fields: [myUserId], references: [id], onDelete: Cascade)

  @@index([myUserId])
  @@index([analysisId])
  @@index([applicationId])
  @@map("saved_suggestions")
}

model cv_uploads {
  id               String   @id @default(uuid())
  myUserId         String?
  originalFilename String
  fileType         String
  fileUrl          String
  storageKey       String
  fileSizeBytes    BigInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  myUser           myusers? @relation(fields: [myUserId], references: [id], onDelete: Cascade)

  @@index([myUserId])
  @@map("cv_uploads")
}

model myusers {
  id               String              @id
  createdAt        DateTime            @default(now())
  updatedAt        DateTime
  applications     applications[]
  improvedFiles    improved_files[]
  user             User                @relation(fields: [id], references: [id], onDelete: Cascade)
  savedSuggestions saved_suggestions[]
  cvUploads        cv_uploads[]

  @@map("myusers")
}
